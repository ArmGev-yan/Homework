#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МесяцНачисления = НачалоМесяца(ТекущаяДатаСеанса());
	ПроводитьПослеЗаполнения = Истина;
	ТолькоНепроведенные = Ложь;
	ТолькоДиагностика = Ложь;
	
	Элементы.МесяцНачисления.ФорматРедактирования = "ДФ='ММММ гггг'";
	Элементы.МесяцНачисления.Формат = "ДФ='ММММ гггг'";
	Элементы.ДокументыКЗаполнениюМесяцНачисления.Формат = "ДФ='ММММ гггг'";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МесяцНачисленияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(МесяцНачисления) Тогда
		МесяцНачисления = НачалоМесяца(МесяцНачисления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументДляДобавленияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ДокументДляДобавления) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьДокументНаСервере(ДокументДляДобавления);
	ДокументДляДобавления = ПредопределенноеЗначение("Документ.НачислениеЗарплаты.ПустаяСсылка");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьДокументы(Команда)
	
	Если Не ЗначениеЗаполнено(МесяцНачисления) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите месяц начисления.'"));
		Возврат;
	КонецЕсли;
	ПодобратьДокументыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	УстановитьПометки(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	УстановитьПометки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыбранные(Команда)
	
	Количество = КоличествоОтмеченных();
	Если Количество = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте один или несколько документов.'"));
		Возврат;
	КонецЕсли;
	
	Если ТолькоДиагностика Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Показать результат расчета по %1 документам и ничего не записывать?'"),
			Количество);
	ИначеЕсли ПроводитьПослеЗаполнения Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Заполнить и провести %1 документов «Начисление зарплаты» без фонового задания?'"),
			Количество);
	Иначе
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Заполнить %1 документов «Начисление зарплаты» без проведения и без фонового задания?'"),
			Количество);
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьВыбранныеПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьВыбранныеПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Отмеченные = Новый Массив;
	Для Каждого СтрокаДокумента Из ДокументыКЗаполнению Цикл
		Если СтрокаДокумента.Пометка И ЗначениеЗаполнено(СтрокаДокумента.Ссылка) Тогда
			Отмеченные.Добавить(СтрокаДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Всего = Отмеченные.Количество();
	Номер = 0;
	Для Каждого СтрокаДокумента Из Отмеченные Цикл
		Номер = Номер + 1;
		Состояние(
			СтрШаблон(НСтр("ru = 'Заполнение %1 из %2'"), Номер, Всего),
			Окр(Номер / Всего * 100, 0),
			Строка(СтрокаДокумента.Ссылка));
		
		Результат = ЗаполнитьДокументНаСервере(СтрокаДокумента.Ссылка, ПроводитьПослеЗаполнения, ТолькоДиагностика);
		СтрокаДокумента.Состояние = Результат.Состояние;
		СтрокаДокумента.ТекстОшибки = Результат.ТекстОшибки;
		Если Результат.Успех Тогда
			СтрокаДокумента.КоличествоНачислений = Результат.КоличествоНачислений;
			Если Не ТолькоДиагностика Тогда
				СтрокаДокумента.Проведен = Результат.Проведен;
			КонецЕсли;
		КонецЕсли;
		
		Если Не Результат.Успех Тогда
			Сообщить(Строка(СтрокаДокумента.Ссылка) + ": " + Результат.ТекстОшибки);
		ИначеЕсли ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			Сообщить(Строка(СтрокаДокумента.Ссылка) + ": " + Результат.ТекстОшибки);
		КонецЕсли;
		Если ТолькоДиагностика И ЗначениеЗаполнено(Результат.Диагностика) Тогда
			Сообщить(Результат.Диагностика);
		КонецЕсли;
	КонецЦикла;
	
	Состояние(НСтр("ru = 'Готово'"));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Пометка)
	
	Для Каждого СтрокаДокумента Из ДокументыКЗаполнению Цикл
		СтрокаДокумента.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция КоличествоОтмеченных()
	
	Количество = 0;
	Для Каждого СтрокаДокумента Из ДокументыКЗаполнению Цикл
		Если СтрокаДокумента.Пометка И ЗначениеЗаполнено(СтрокаДокумента.Ссылка) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

&НаСервере
Процедура ПодобратьДокументыНаСервере()
	
	ДокументыКЗаполнению.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Подразделение КАК Подразделение,
	|	Док.МесяцНачисления КАК МесяцНачисления,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.НачислениеЗарплаты КАК Док
	|ГДЕ
	|	Док.МесяцНачисления = &МесяцНачисления
	|	И НЕ Док.ПометкаУдаления
	|	И (&БезОтбораОрганизации
	|		ИЛИ Док.Организация = &Организация)
	|	И (НЕ &ТолькоНепроведенные
	|		ИЛИ НЕ Док.Проведен)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	Запрос.УстановитьПараметр("МесяцНачисления", НачалоМесяца(МесяцНачисления));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ТолькоНепроведенные", ТолькоНепроведенные);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДокументыКЗаполнению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДокументНаСервере(Знач ДокументСсылка)
	
	Найденные = ДокументыКЗаполнению.НайтиСтроки(Новый Структура("Ссылка", ДокументСсылка));
	Если Найденные.Количество() > 0 Тогда
		Найденные[0].Пометка = Истина;
		Возврат;
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДокументСсылка, "Номер, Дата, Организация, Подразделение, МесяцНачисления, Проведен");
	НоваяСтрока = ДокументыКЗаполнению.Добавить();
	НоваяСтрока.Пометка = Истина;
	НоваяСтрока.Ссылка = ДокументСсылка;
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Реквизиты);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДокументНаСервере(Знач ДокументСсылка, Знач Проводить, Знач Диагностика)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ЗаполнитьДокумент(ДокументСсылка, Проводить, Диагностика);
	
КонецФункции

#КонецОбласти
