	Соответствие.Вставить("УдержанияПерерасчет", "УдержанияПерерасчет");
	Соответствие.Вставить("НДФЛ", "НДФЛ");
	Соответствие.Вставить("Взносы", "Взносы");
	Соответствие.Вставить("ВзносыПерерасчет", "ВзносыПерерасчет");
	Соответствие.Вставить("НДФЛПерерасчет", "НДФЛПерерасчет");
