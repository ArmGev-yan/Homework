	Соответствие.Вставить("Пособия", "Пособия");
	Соответствие.Вставить("ПособияПерерасчет", "ПособияПерерасчет");
	Соответствие.Вставить("КорректировкиВыплаты", "КорректировкиВыплаты");
	Соответствие.Вставить("ПримененныеВычеты", "ПримененныеВычетыНаДетейИИмущественные");
	Соответствие.Вставить("ПримененныеВычетыНаДетейИИмущественные", "ПримененныеВычетыНаДетейИИмущественные");
	Соответствие.Вставить("Вычеты", "ПримененныеВычетыНаДетейИИмущественные");
	Соответствие.Вставить("РаспределениеРезультатовНачислений", "РаспределениеРезультатовНачислений");
	Соответствие.Вставить("РаспределениеРезультатовУдержаний", "РаспределениеРезультатовУдержаний");
	Соответствие.Вставить("РаспределениеПоТерриториямУсловиямТруда", "РаспределениеПоТерриториямУсловиямТруда");
	Соответствие.Вставить("Территории", "РаспределениеПоТерриториямУсловиямТруда");
	Соответствие.Вставить("ФизическиеЛица", "ФизическиеЛица");
	Возврат Соответствие;
	
КонецФункции

Функция ЭтоТаблицаСсылокНаСтроку(ИмяТаблицы)
	
	Возврат ИмяТаблицы = "Показатели"
		Или ИмяТаблицы = "ПримененныеВычетыНаДетейИИмущественные"
		Или ИмяТаблицы = "РаспределениеРезультатовНачислений"
		Или ИмяТаблицы = "РаспределениеРезультатовУдержаний"
		Или ИмяТаблицы = "РаспределениеПоТерриториямУсловиямТруда";
	
КонецФункции

Функция ЗагрузитьКоллекцию(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, Коллекция, ИдентификаторРодителя, УчетИдентификаторов)
	
	МетаТЧ = МетаданныеДокумента.ТабличныеЧасти[ИмяТаблицы];
	ТипыРеквизитов = ТипыРеквизитовТабличнойЧасти(МетаТЧ);
	Количество = 0;
	
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаИсточника Из Коллекция Цикл
			ЗагрузитьСтроку(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, МетаТЧ, ТипыРеквизитов, СтрокаИсточника, ИдентификаторРодителя, УчетИдентификаторов);
			Количество = Количество + 1;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Для Каждого СтрокаИсточника Из Коллекция Цикл
			Если ТипЗнч(СтрокаИсточника) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			ЗагрузитьСтроку(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, МетаТЧ, ТипыРеквизитов, СтрокаИсточника, ИдентификаторРодителя, УчетИдентификаторов);
			Количество = Количество + 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Количество;
	
КонецФункции

Процедура ЗагрузитьСтроку(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, МетаТЧ, ТипыРеквизитов, СтрокаИсточника, ИдентификаторРодителя, УчетИдентификаторов)
	
	СтрокаПриемник = ДокументОбъект[ИмяТаблицы].Добавить();
	СкопироватьСовпадающиеПоля(СтрокаПриемник, СтрокаИсточника, ТипыРеквизитов);
	
	ИдентификаторСтроки = 0;
	Если ЭтоТаблицаСсылокНаСтроку(ИмяТаблицы) Тогда
		Если ИдентификаторРодителя <> Неопределено Тогда
			УстановитьИдентификаторСтроки(СтрокаПриемник, МетаТЧ, ИдентификаторРодителя);
		Иначе
			ИдентификаторСтроки = ПеревестиИдентификатор(УчетИдентификаторов, ИдентификаторИсточника(СтрокаИсточника));
			Если ИдентификаторСтроки > 0 Тогда
				УстановитьИдентификаторСтроки(СтрокаПриемник, МетаТЧ, ИдентификаторСтроки);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИдентификаторСтроки = ЗанятьИдентификатор(УчетИдентификаторов, ИдентификаторИсточника(СтрокаИсточника));
		УстановитьИдентификаторСтроки(СтрокаПриемник, МетаТЧ, ИдентификаторСтроки);
		ПеренестиВложенныеТаблицы(ДокументОбъект, МетаданныеДокумента, СтрокаИсточника, ИдентификаторСтроки, УчетИдентификаторов);
	КонецЕсли;
	
КонецПроцедуры

Процедура СкопироватьСовпадающиеПоля(СтрокаПриемник, СтрокаИсточника, ТипыРеквизитов)
	
	Для Каждого КлючИЗначение Из ТипыРеквизитов Цикл
		ИмяРеквизита = КлючИЗначение.Ключ;
		Если Не ЕстьКолонка(СтрокаИсточника, ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Значение = СтрокаИсточника[ИмяРеквизита];
		Если Не ЗначениеМожноЗаписатьВРеквизит(Значение, КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			СтрокаПриемник[ИмяРеквизита] = Значение;
		Исключение
			// Квалификатор типа (длина, разрядность) не принял значение этого релиза.
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗначениеМожноЗаписатьВРеквизит(Значение, ОписаниеТипа)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null")
		Или ТипЗначения = Тип("ТаблицаЗначений")
		Или ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ХранилищеЗначения") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ОписаниеТипа.СодержитТип(ТипЗначения);
	
КонецФункции

Процедура ПеренестиВложенныеТаблицы(ДокументОбъект, МетаданныеДокумента, СтрокаИсточника, ИдентификаторСтроки, УчетИдентификаторов)
	
	Если ТипЗнч(СтрокаИсточника) = Тип("СтрокаТаблицыЗначений") Тогда
		Для Каждого Колонка Из СтрокаИсточника.Владелец().Колонки Цикл
			ПеренестиВложенноеЗначение(ДокументОбъект, МетаданныеДокумента, Колонка.Имя, СтрокаИсточника[Колонка.Имя], ИдентификаторСтроки, УчетИдентификаторов);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СтрокаИсточника) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из СтрокаИсточника Цикл
			ПеренестиВложенноеЗначение(ДокументОбъект, МетаданныеДокумента, КлючИЗначение.Ключ, КлючИЗначение.Значение, ИдентификаторСтроки, УчетИдентификаторов);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиВложенноеЗначение(ДокументОбъект, МетаданныеДокумента, ИмяКолонки, Значение, ИдентификаторСтроки, УчетИдентификаторов)
	
	Если Не ЭтоКоллекцияСтрок(Значение) Тогда
		Возврат;
	КонецЕсли;
	ИмяТаблицы = ИмяТаблицыДокумента(ИмяКолонки, МетаданныеДокумента);
	Если ИмяТаблицы = "" Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьКоллекцию(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, Значение, ИдентификаторСтроки, УчетИдентификаторов);
	
КонецПроцедуры

Функция ТипыРеквизитовТабличнойЧасти(МетаТЧ)
	
	Типы = Новый Соответствие;
	Для Каждого Реквизит Из МетаТЧ.Реквизиты Цикл
		Типы.Вставить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	Возврат Типы;
	
КонецФункции

Функция ЕстьКолонка(СтрокаИсточника, ИмяКолонки)
	
	ТипСтроки = ТипЗнч(СтрокаИсточника);
	Если ТипСтроки = Тип("Структура") Тогда
		Возврат СтрокаИсточника.Свойство(ИмяКолонки);
	ИначеЕсли ТипСтроки = Тип("СтрокаТаблицыЗначений") Тогда
		Возврат СтрокаИсточника.Владелец().Колонки.Найти(ИмяКолонки) <> Неопределено;
	КонецЕсли;
	Возврат Ложь;
	
КонецФункции

Функция ИдентификаторИсточника(СтрокаИсточника)
	
	Имена = Новый Массив;
	Имена.Добавить("ИдентификаторСтрокиВидаРасчета");
	Имена.Добавить("ИдентификаторСтроки");
	Для Каждого ИмяПоля Из Имена Цикл
		Если Не ЕстьКолонка(СтрокаИсточника, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Значение = СтрокаИсточника[ИмяПоля];
		Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
	
КонецФункции

Процедура УстановитьИдентификаторСтроки(СтрокаПриемник, МетаТЧ, Идентификатор)
	
	ИмяПоля = "";
	Если МетаТЧ.Реквизиты.Найти("ИдентификаторСтрокиВидаРасчета") <> Неопределено Тогда
		ИмяПоля = "ИдентификаторСтрокиВидаРасчета";
	ИначеЕсли МетаТЧ.Реквизиты.Найти("ИдентификаторСтроки") <> Неопределено Тогда
		ИмяПоля = "ИдентификаторСтроки";
	КонецЕсли;
	Если ИмяПоля <> "" Тогда
		СтрокаПриемник[ИмяПоля] = Идентификатор;
	КонецЕсли;
	
КонецПроцедуры

Функция НовыйУчетИдентификаторов()
	
	Учет = Новый Структура;
	Учет.Вставить("Занятые", Новый Соответствие);
	Учет.Вставить("Замены", Новый Соответствие);
	Учет.Вставить("Повторы", Новый Соответствие);
	Учет.Вставить("Максимум", 0);
	Учет.Вставить("БылиКоллизии", Ложь);
	Возврат Учет;
	
КонецФункции

Функция ЗанятьИдентификатор(Учет, Предлагаемый)
	
	Идентификатор = 0;
	Если ТипЗнч(Предлагаемый) = Тип("Число") И Предлагаемый > 0 Тогда
		Идентификатор = Предлагаемый;
	КонецЕсли;
	
	Если Идентификатор = 0 Или Учет.Занятые.Получить(Идентификатор) <> Неопределено Или Учет.Замены.Получить(Идентификатор) <> Неопределено Тогда
		Если Идентификатор > 0 Тогда
			Учет.БылиКоллизии = Истина;
			Учет.Повторы.Вставить(Идентификатор, Истина);
		КонецЕсли;
		Идентификатор = Учет.Максимум + 1;
	Иначе
		Учет.Замены.Вставить(Предлагаемый, Идентификатор);
	КонецЕсли;
	
	Учет.Занятые.Вставить(Идентификатор, Истина);
	Если Идентификатор > Учет.Максимум Тогда
		Учет.Максимум = Идентификатор;
	КонецЕсли;
	Возврат Идентификатор;
	
КонецФункции

Функция ПеревестиИдентификатор(Учет, Идентификатор)
	
	Если ТипЗнч(Идентификатор) <> Тип("Число") Или Идентификатор <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если Учет.Повторы.Получить(Идентификатор) <> Неопределено Тогда
		Возврат Идентификатор;
	КонецЕсли;
	Замена = Учет.Замены.Получить(Идентификатор);
	Если Замена = Неопределено Тогда
		Возврат Идентификатор;
	КонецЕсли;
	Возврат Замена;
	
КонецФункции

Функция ЭтоКоллекцияСтрок(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("ТаблицаЗначений") Или ТипЗначения = Тип("Массив");
	
КонецФункции

Функция КоличествоСтрокТаблицы(Таблицы, ИмяТаблицы)
	
	Если ТипЗнч(Таблицы) <> Тип("Структура") Или Не Таблицы.Свойство(ИмяТаблицы) Тогда
		Возврат 0;
	КонецЕсли;
	Коллекция = Таблицы[ИмяТаблицы];
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Или ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат Коллекция.Количество();
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция ПредставлениеДанныхЗаполнения(ДокументСсылка, Способ, ИсходныеДанные, Таблицы)
	
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Документ: %1'"), ДокументСсылка));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Способ: %1'"), Способ));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Тип ответа: %1'"), Строка(ТипЗнч(ИсходныеДанные))));
	Если ТипЗнч(ИсходныеДанные) = Тип("Структура") Тогда
		Строки.Добавить(НСтр("ru = 'Ключи ответа: '") + СтрСоединить(КлючиСтруктуры(ИсходныеДанные), ", "));
	КонецЕсли;
	
	Если ТипЗнч(Таблицы) <> Тип("Структура") Тогда
		Строки.Добавить(НСтр("ru = 'После разбора это не структура таблиц.'"));
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	
	Строки.Добавить(НСтр("ru = 'Таблицы расчета:'"));
	Для Каждого КлючИЗначение Из Таблицы Цикл
		Если ЭтоКоллекцияСтрок(КлючИЗначение.Значение) Тогда
			Строки.Добавить(СтрШаблон("- %1: %2; колонки: %3",
				КлючИЗначение.Ключ,
				КлючИЗначение.Значение.Количество(),
				ПредставлениеКолонок(КлючИЗначение.Значение)));
		Иначе
			Строки.Добавить(СтрШаблон("- %1: %2", КлючИЗначение.Ключ, Строка(ТипЗнч(КлючИЗначение.Значение))));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ПредставлениеКолонок(Коллекция)
	
	Имена = Новый Массив;
	Если ТипЗнч(Коллекция) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Колонка Из Коллекция.Колонки Цикл
			Имена.Добавить(Колонка.Имя);
			Если Имена.Количество() >= 40 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Массив") И Коллекция.Количество() > 0 И ТипЗнч(Коллекция[0]) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Коллекция[0] Цикл
			Имена.Добавить(КлючИЗначение.Ключ);
			Если Имена.Количество() >= 40 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Имена, ", ");
	
КонецФункции

Функция КлючиСтруктуры(Данные)
	
	Ключи = Новый Массив;
	Для Каждого КлючИЗначение Из Данные Цикл
		Ключи.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Возврат Ключи;
	
КонецФункции

Процедура РазблокироватьДокумент(ДокументОбъект)
	
	Попытка
		ДокументОбъект.Разблокировать();
	Исключение
		// Запись уже выполнена, ошибка снятия блокировки не отменяет заполнение.
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаписатьВЖурнал(ДокументСсылка, Текст, ЭтоОшибка)
	
	Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	Попытка
		ЗаписьЖурналаРегистрации(
			"ЗаполнениеНачисленийЗарплатыБезФона",
			Уровень,
			Метаданные.Документы.НачислениеЗарплаты,
			ДокументСсылка,
			Текст);
	Исключение
		// Журнал не должен скрывать результат заполнения.
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
