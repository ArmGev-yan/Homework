// Внешняя обработка для ЗУП 3.1.
// Кнопка «Заполнить» документа НачислениеЗарплаты запускает фоновое задание
// Документы.НачислениеЗарплаты.ПодготовитьДанныеДляЗаполнения.
// Здесь та же процедура вызывается сразу в сеансе, без фонового задания,
// а результат переносится в выбранные документы.

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.0");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0.0";
	ПараметрыРегистрации.Наименование = НСтр("ru = 'Заполнение начислений зарплаты без фонового задания'");
	ПараметрыРегистрации.Информация = НСтр("ru = 'Заполняет выбранные документы «Начисление зарплаты» тем же расчетом, что кнопка «Заполнить», без фонового задания.'");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	
	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Заполнение начислений зарплаты без фонового задания'");
	Команда.Идентификатор = "ЗаполнениеНачисленийЗарплатыБезФона";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Если Команда.Владелец().Колонки.Найти("ПоказыватьОповещение") <> Неопределено Тогда
		Команда.ПоказыватьОповещение = Ложь;
	КонецЕсли;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// Заполняет один документ НачислениеЗарплаты синхронно.
//
// Возвращаемое значение:
//  Структура - Успех, Состояние, ТекстОшибки, КоличествоНачислений, Диагностика, Проведен, СпособРасчета.
//
Функция ЗаполнитьДокумент(ДокументСсылка, ПроводитьПослеЗаполнения, ТолькоДиагностика = Ложь) Экспорт
	
	Результат = НовыйРезультатЗаполнения();
	
	Если ТипЗнч(ДокументСсылка) <> Тип("ДокументСсылка.НачислениеЗарплаты") Или Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Результат.Состояние = НСтр("ru = 'Ошибка'");
		Результат.ТекстОшибки = НСтр("ru = 'Укажите записанный документ «Начисление зарплаты».'");
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДокументДляРасчета = ДокументСсылка.ПолучитьОбъект();
		Если ДокументДляРасчета = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Документ не найден или удален.'");
		КонецЕсли;
		Если ДокументДляРасчета.ПометкаУдаления Тогда
			ВызватьИсключение НСтр("ru = 'Документ помечен на удаление.'");
		КонецЕсли;
		
		ПараметрыЗаполнения = ПараметрыЗаполненияДокумента(ДокументДляРасчета);
		Расчет = РассчитатьДанныеЗаполнения(ПараметрыЗаполнения);
		Результат.СпособРасчета = Расчет.Способ;
		Таблицы = НормализоватьДанныеЗаполнения(Расчет.Данные);
		
		Если ТолькоДиагностика Тогда
			Результат.Успех = Истина;
			Результат.Состояние = НСтр("ru = 'Диагностика, документ не записан'");
			Результат.Диагностика = ПредставлениеДанныхЗаполнения(ДокументСсылка, Расчет.Способ, Расчет.Данные, Таблицы);
			Результат.КоличествоНачислений = КоличествоСтрокТаблицы(Таблицы, "Начисления");
			Возврат Результат;
		КонецЕсли;
		
		ЗаписатьЗаполненныйДокумент(ДокументСсылка, ДокументДляРасчета, Таблицы, ПроводитьПослеЗаполнения, Результат);
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.Состояние = НСтр("ru = 'Ошибка'");
		Результат.ТекстОшибки = КраткоеПредставлениеОшибки(Информация);
		Результат.Диагностика = ПодробноеПредставлениеОшибки(Информация);
		ЗаписатьВЖурнал(ДокументСсылка, Результат.Диагностика, Истина);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатЗаполнения()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Состояние", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоНачислений", 0);
	Результат.Вставить("Диагностика", "");
	Результат.Вставить("Проведен", Ложь);
	Результат.Вставить("СпособРасчета", "");
	Возврат Результат;
	
КонецФункции

Функция ПараметрыЗаполненияДокумента(ДокументОбъект)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ОписаниеДокумента = ОписаниеДокументаНачислениеЗарплаты(ДокументОбъект, МетаданныеДокумента);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Ссылка", ДокументОбъект.Ссылка);
	ДополнительныеПараметры.Вставить("Документ", ДокументОбъект.Ссылка);
	ДополнительныеПараметры.Вставить("ДокументСсылка", ДокументОбъект.Ссылка);
	ДополнительныеПараметры.Вставить("Регистратор", ДокументОбъект.Ссылка);
	ДополнительныеПараметры.Вставить("ИсключаемыйРегистратор", ДокументОбъект.Ссылка);
	ДополнительныеПараметры.Вставить("Организация", ДокументОбъект.Организация);
	ДополнительныеПараметры.Вставить("МесяцНачисления", ДокументОбъект.МесяцНачисления);
	ДополнительныеПараметры.Вставить("Сотрудники", Неопределено);
	ДополнительныеПараметры.Вставить("ОкончательныйРасчет", Истина);
	ДополнительныеПараметры.Вставить("ОкончательныйРасчетНДФЛ", Истина);
	
	ВставитьРеквизитДокумента(ДополнительныеПараметры, ДокументОбъект, МетаданныеДокумента, "Подразделение");
	ВставитьРеквизитДокумента(ДополнительныеПараметры, ДокументОбъект, МетаданныеДокумента, "РежимДоначисления");
	ВставитьРеквизитДокумента(ДополнительныеПараметры, ДокументОбъект, МетаданныеДокумента, "ПорядокВыплаты");
	ВставитьРеквизитДокумента(ДополнительныеПараметры, ДокументОбъект, МетаданныеДокумента, "ПланируемаяДатаВыплаты");
	ВставитьРеквизитДокумента(ДополнительныеПараметры, ДокументОбъект, МетаданныеДокумента, "ИсправленныйДокумент");
	
	Если ДополнительныеПараметры.Свойство("ПланируемаяДатаВыплаты") Тогда
		ДополнительныеПараметры.Вставить("ДатаВыплаты", ДополнительныеПараметры.ПланируемаяДатаВыплаты);
	КонецЕсли;
	
	РежимНачисления = РежимОкончательногоРасчета();
	Если РежимНачисления <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("РежимНачисления", РежимНачисления);
	КонецЕсли;
	
	ПараметрыЗаполнения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительныеПараметры);
	ПараметрыЗаполнения.Вставить("ОписаниеДокумента", ОписаниеДокумента);
	ПараметрыЗаполнения.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

Процедура ВставитьРеквизитДокумента(Приемник, ДокументОбъект, МетаданныеДокумента, ИмяРеквизита)
	
	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Приемник.Вставить(ИмяРеквизита, ДокументОбъект[ИмяРеквизита]);
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеДокументаНачислениеЗарплаты(ДокументОбъект, МетаданныеДокумента)
	
	Описание = Новый Структура;
	Описание.Вставить("МесяцНачисленияИмя", "МесяцНачисления");
	Описание.Вставить("ПериодРегистрацииИмя", "");
	Описание.Вставить("ОрганизацияИмя", "Организация");
	Описание.Вставить("ПодразделениеИмя", ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, "Подразделение"));
	Описание.Вставить("РежимДоначисленияИмя", ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, "РежимДоначисления"));
	Описание.Вставить("ПорядокВыплатыИмя", ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, "ПорядокВыплаты"));
	Описание.Вставить("ПланируемаяДатаВыплатыИмя", ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, "ПланируемаяДатаВыплаты"));
	Описание.Вставить("ДатаВыплатыИмя", ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, "ПланируемаяДатаВыплаты"));
	Описание.Вставить("НачисленияИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Начисления"));
	Описание.Вставить("НачисленияПерерасчетИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "НачисленияПерерасчет"));
	Описание.Вставить("НачисленияПоДоговорамИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "НачисленияПоДоговорам"));
	Описание.Вставить("ЗависимыеНачисленияИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "ЗависимыеНачисления"));
	Описание.Вставить("УдержанияИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Удержания"));
	Описание.Вставить("УдержанияПерерасчетИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "УдержанияПерерасчет"));
	Описание.Вставить("НДФЛИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "НДФЛ"));
	Описание.Вставить("ВзносыИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Взносы"));
	Описание.Вставить("ПогашениеЗаймовИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "ПогашениеЗаймов"));
	Описание.Вставить("КорректировкиВыплатыИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "КорректировкиВыплаты"));
	Описание.Вставить("ЛьготыИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Льготы"));
	Описание.Вставить("ПособияИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Пособия"));
	Описание.Вставить("ПособияПерерасчетИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "ПособияПерерасчет"));
	Описание.Вставить("ПримененныеВычетыИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "ПримененныеВычетыНаДетейИИмущественные"));
	Описание.Вставить("ПоказателиИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "Показатели"));
	Описание.Вставить("РаспределениеРезультатовНачисленийИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "РаспределениеРезультатовНачислений"));
	Описание.Вставить("РаспределениеРезультатовУдержанийИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "РаспределениеРезультатовУдержаний"));
	Описание.Вставить("РаспределениеПоТерриториямУсловиямТрудаИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "РаспределениеПоТерриториямУсловиямТруда"));
	Описание.Вставить("ФизическиеЛицаИмя", ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, "ФизическиеЛица"));
	Описание.Вставить("ОписанияТаблиц", Новый Массив);
	Описание.Вставить("ОписанияТаблицНачислений", Новый Массив);
	Описание.Вставить("ОписанияТаблицДляРаспределенияРезультата", Новый Массив);
	Описание.Вставить("ОписанияТаблицСРаспределениемПоТерриториямУсловиямТруда", Новый Массив);
	Описание.Вставить("ОкончательныйРасчет", Истина);
	Описание.Вставить("ОкончательныйРасчетНДФЛ", Истина);
	Описание.Вставить("ПериодДействияВШапке", Истина);
	Описание.Вставить("ЭтоНачислениеЗарплаты", Истина);
	Описание.Вставить("Ссылка", ДокументОбъект.Ссылка);
	Описание.Вставить("Регистратор", ДокументОбъект.Ссылка);
	
	РежимНачисления = РежимОкончательногоРасчета();
	Если РежимНачисления <> Неопределено Тогда
		Описание.Вставить("РежимНачисления", РежимНачисления);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ИмяРеквизитаЕслиЕсть(МетаданныеДокумента, ИмяРеквизита)
	
	Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИмяРеквизита;
	
КонецФункции

Функция ИмяТабличнойЧастиЕслиЕсть(МетаданныеДокумента, ИмяТабличнойЧасти)
	
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИмяТабличнойЧасти;
	
КонецФункции

Функция РежимОкончательногоРасчета()
	
	МетаданныеПеречисления = Метаданные.Перечисления.Найти("РежимыНачисленияЗарплаты");
	Если МетаданныеПеречисления = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если МетаданныеПеречисления.ЗначенияПеречисления.Найти("ОкончательныйРасчет") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления.РежимыНачисленияЗарплаты.ОкончательныйРасчет;
	
КонецФункции

Функция РассчитатьДанныеЗаполнения(ПараметрыЗаполнения)
	
	Ошибки = Новый Массив;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	Попытка
		// Та же экспортная процедура, которую кнопка «Заполнить» ставит в фоновое задание.
		// Вызов прямой, поэтому расчет идет в этом сеансе.
		Документы.НачислениеЗарплаты.ПодготовитьДанныеДляЗаполнения(ПараметрыЗаполнения, АдресХранилища);
		Данные = ПолучитьИзВременногоХранилища(АдресХранилища);
		УдалитьИзВременногоХранилища(АдресХранилища);
		Если Данные <> Неопределено Тогда
			Возврат Новый Структура("Данные, Способ", Данные,
				НСтр("ru = 'Документы.НачислениеЗарплаты.ПодготовитьДанныеДляЗаполнения'"));
		КонецЕсли;
		Ошибки.Добавить(НСтр("ru = 'ПодготовитьДанныеДляЗаполнения вернула пустой результат.'"));
	Исключение
		Ошибки.Добавить(НСтр("ru = 'ПодготовитьДанныеДляЗаполнения'") + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
			УдалитьИзВременногоХранилища(АдресХранилища);
		КонецЕсли;
	КонецПопытки;
	
	Попытка
		Данные = РасчетЗарплатыРасширенный.ДанныеДляЗаполненияТаблицДокумента(
			ПараметрыЗаполнения.ОписаниеДокумента,
			ПараметрыЗаполнения.Организация,
			ПараметрыЗаполнения.МесяцНачисления,
			ПараметрыЗаполнения.ДополнительныеПараметры);
		Если Данные <> Неопределено Тогда
			Возврат Новый Структура("Данные, Способ", Данные,
				НСтр("ru = 'РасчетЗарплатыРасширенный.ДанныеДляЗаполненияТаблицДокумента'"));
		КонецЕсли;
		Ошибки.Добавить(НСтр("ru = 'ДанныеДляЗаполненияТаблицДокумента вернула пустой результат.'"));
	Исключение
		Ошибки.Добавить(НСтр("ru = 'ДанныеДляЗаполненияТаблицДокумента'") + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ВызватьИсключение НСтр("ru = 'Не удалось заполнить документ без фонового задания.'")
		+ Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	
КонецФункции

Функция НормализоватьДанныеЗаполнения(Данные, Глубина = 0)
	
	Если Данные = Неопределено Или Глубина > 4 Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если СтруктураСодержитРасчетнуюТаблицу(Данные) Тогда
			Возврат Данные;
		КонецЕсли;
		Для Каждого ИмяОбертки Из ИменаОбертокРезультата() Цикл
			Вложенные = Неопределено;
			Если Данные.Свойство(ИмяОбертки, Вложенные) И Вложенные <> Неопределено И Вложенные <> Данные Тогда
				Нормализованные = НормализоватьДанныеЗаполнения(Вложенные, Глубина + 1);
				Если ТипЗнч(Нормализованные) = Тип("Структура") И СтруктураСодержитРасчетнуюТаблицу(Нормализованные) Тогда
					Возврат Нормализованные;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		Возврат Новый Структура("Начисления", Данные);
	КонецЕсли;
	
	Попытка
		Если Данные.Зарплата <> Неопределено Тогда
			Возврат НормализоватьДанныеЗаполнения(Данные.Зарплата, Глубина + 1);
		КонецЕсли;
	Исключение
		Возврат Данные;
	КонецПопытки;
	
	Возврат Данные;
	
КонецФункции

Функция ИменаОбертокРезультата()
	
	Имена = Новый Массив;
	Имена.Добавить("ДанныеДляЗаполненияТаблицДокумента");
	Имена.Добавить("ДанныеЗаполнения");
	Имена.Добавить("ДанныеДляЗаполнения");
	Имена.Добавить("РезультатЗаполнения");
	Имена.Добавить("Результат");
	Имена.Добавить("Зарплата");
	Возврат Имена;
	
КонецФункции

Функция СтруктураСодержитРасчетнуюТаблицу(Данные)
	
	ИменаТаблиц = ИменаРасчетныхТаблиц();
	Для Каждого КлючИЗначение Из Данные Цикл
		Если Не ЭтоКоллекцияСтрок(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если ИменаТаблиц.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ИменаРасчетныхТаблиц()
	
	Имена = Новый Соответствие;
	Для Каждого ИмяТаблицы Из СтрРазделить(
		"Начисления,НачисленияПерерасчет,НачисленияПоДоговорам,Удержания,УдержанияПерерасчет,НДФЛ,Взносы,ПогашениеЗаймов,Показатели,Льготы,Пособия,ПособияПерерасчет,КорректировкиВыплаты,ПримененныеВычеты,ПримененныеВычетыНаДетейИИмущественные,Вычеты",
		",", Ложь) Цикл
		Имена.Вставить(ИмяТаблицы, Истина);
	КонецЦикла;
	Возврат Имена;
	
КонецФункции

Процедура ЗаписатьЗаполненныйДокумент(ДокументСсылка, ОбразецШапки, Таблицы, ПроводитьПослеЗаполнения, Результат)
	
	Если ТипЗнч(Таблицы) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Расчет не вернул структуру таблиц документа. Запустите режим «Только диагностика» и пришлите текст.'");
	КонецЕсли;
	
	ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Документ удален, пока выполнялся расчет.'");
	КонецЕсли;
	
	ТекстРасхождения = ТекстРасхожденияШапки(ОбразецШапки, ДокументОбъект);
	Если ЗначениеЗаполнено(ТекстРасхождения) Тогда
		ВызватьИсключение ТекстРасхождения;
	КонецЕсли;
	
	ДокументОбъект.Заблокировать();
	Попытка
		Статистика = ПеренестиТаблицыВДокумент(ДокументОбъект, Таблицы);
		Если Статистика.НайденныеТаблицы.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Расчет выполнен, но в результате нет таблиц документа. Ключи: '")
				+ СтрСоединить(КлючиСтруктуры(Таблицы), ", ");
		КонецЕсли;
		
		ОбновитьКраткийСостав(ДокументОбъект);
		ДокументОбъект.ДополнительныеСвойства.Вставить("УдалитьПерерасчетыТекущегоПериода", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("УдалитьПерерасчетыЗарплаты", Истина);
		
		ЗаписатьОбъектДокумента(ДокументОбъект, ПроводитьПослеЗаполнения, Результат);
		Результат.Успех = Истина;
		Результат.КоличествоНачислений = ДокументОбъект.Начисления.Количество();
		Результат.Проведен = ДокументОбъект.Проведен;
		Результат.Диагностика = СтрШаблон(
			НСтр("ru = '%1. Способ: %2. Таблицы: %3'"),
			Результат.Состояние,
			Результат.СпособРасчета,
			СтрСоединить(Статистика.НайденныеТаблицы, ", "));
		Если Статистика.БылиКоллизииИдентификаторов Тогда
			Результат.Диагностика = Результат.Диагностика + Символы.ПС
				+ НСтр("ru = 'В расчете повторялись идентификаторы строк. Проверьте показатели и вычеты в документе.'");
		КонецЕсли;
		ЗаписатьВЖурнал(ДокументСсылка, Результат.Диагностика, Ложь);
		РазблокироватьДокумент(ДокументОбъект);
	Исключение
		РазблокироватьДокумент(ДокументОбъект);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ТекстРасхожденияШапки(Образец, ДокументОбъект)
	
	Имена = СтрРазделить("Организация,МесяцНачисления,Подразделение,РежимДоначисления,ПорядокВыплаты,ПланируемаяДатаВыплаты", ",", Ложь);
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Для Каждого ИмяРеквизита Из Имена Цикл
		Если МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Образец[ИмяРеквизита] <> ДокументОбъект[ИмяРеквизита] Тогда
			Возврат НСтр("ru = 'Пока выполнялся расчет, в документе изменилась шапка. Заполните его еще раз.'");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Процедура ЗаписатьОбъектДокумента(ДокументОбъект, ПроводитьПослеЗаполнения, Результат)
	
	Если ПроводитьПослеЗаполнения Тогда
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Результат.Состояние = НСтр("ru = 'Заполнен и проведен'");
			Возврат;
		Исключение
			Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	
	Если ДокументОбъект.Проведен Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если ПроводитьПослеЗаполнения Тогда
			Результат.Состояние = НСтр("ru = 'Заполнен, провести не удалось'");
		Иначе
			Результат.Состояние = НСтр("ru = 'Заполнен, проведение снято'");
		КонецЕсли;
	Иначе
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		Если ПроводитьПослеЗаполнения Тогда
			Результат.Состояние = НСтр("ru = 'Заполнен, провести не удалось'");
		Иначе
			Результат.Состояние = НСтр("ru = 'Заполнен'");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьКраткийСостав(ДокументОбъект)
	
	Если ДокументОбъект.Метаданные().Реквизиты.Найти("КраткийСоставДокумента") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ДокументОбъект.Начисления.Количество() = 0 Тогда
		ДокументОбъект.КраткийСоставДокумента = "";
		Возврат;
	КонецЕсли;
	
	Сотрудники = ДокументОбъект.Начисления.Выгрузить(, "Сотрудник");
	Сотрудники.Свернуть("Сотрудник");
	Попытка
		ДокументОбъект.КраткийСоставДокумента = ЗарплатаКадры.КраткийСоставСотрудников(
			Сотрудники.ВыгрузитьКолонку("Сотрудник"), ДокументОбъект.МесяцНачисления);
	Исключение
		// Состав документа останется прежним, если в этом релизе другая сигнатура.
	КонецПопытки;
	
КонецПроцедуры

Функция ПеренестиТаблицыВДокумент(ДокументОбъект, Таблицы)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ОчиститьРасчетныеТаблицы(ДокументОбъект, МетаданныеДокумента);
	
	Статистика = Новый Структура;
	Статистика.Вставить("НайденныеТаблицы", Новый Массив);
	Статистика.Вставить("БылиКоллизииИдентификаторов", Ложь);
	УчетИдентификаторов = НовыйУчетИдентификаторов();
	УжеЗагружены = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из Таблицы Цикл
		ИмяТаблицы = ИмяТаблицыДокумента(КлючИЗначение.Ключ, МетаданныеДокумента);
		Если ИмяТаблицы = "" Или ЭтоТаблицаСсылокНаСтроку(ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоКоллекцияСтрок(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЗагрузитьКоллекцию(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, КлючИЗначение.Значение, Неопределено, УчетИдентификаторов);
		УжеЗагружены.Вставить(ИмяТаблицы, Истина);
		Статистика.НайденныеТаблицы.Добавить(СтрШаблон("%1: %2", ИмяТаблицы, Количество));
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Таблицы Цикл
		ИмяТаблицы = ИмяТаблицыДокумента(КлючИЗначение.Ключ, МетаданныеДокумента);
		Если ИмяТаблицы = "" Или Не ЭтоТаблицаСсылокНаСтроку(ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		Если УжеЗагружены.Получить(ИмяТаблицы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ДокументОбъект[ИмяТаблицы].Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоКоллекцияСтрок(КлючИЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЗагрузитьКоллекцию(ДокументОбъект, МетаданныеДокумента, ИмяТаблицы, КлючИЗначение.Значение, Неопределено, УчетИдентификаторов);
		Если Количество > 0 Тогда
			УжеЗагружены.Вставить(ИмяТаблицы, Истина);
			Статистика.НайденныеТаблицы.Добавить(СтрШаблон("%1: %2", ИмяТаблицы, Количество));
		КонецЕсли;
	КонецЦикла;
	
	Статистика.БылиКоллизииИдентификаторов = УчетИдентификаторов.БылиКоллизии;
	Возврат Статистика;
	
КонецФункции

Процедура ОчиститьРасчетныеТаблицы(ДокументОбъект, МетаданныеДокумента)
	
	Защищенные = Новый Соответствие;
	Защищенные.Вставить("ДополнительныеРеквизиты", Истина);
	Защищенные.Вставить("НаборыЗначенийДоступа", Истина);
	
	Для Каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Если Защищенные.Получить(ТабличнаяЧасть.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДокументОбъект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;
	
КонецПроцедуры

Функция ИмяТаблицыДокумента(ИмяИсточника, МетаданныеДокумента)
	
	Синоним = СоответствиеТаблицДокумента().Получить(ИмяИсточника);
	Если Синоним <> Неопределено И МетаданныеДокумента.ТабличныеЧасти.Найти(Синоним) <> Неопределено Тогда
		Возврат Синоним;
	КонецЕсли;
	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяИсточника) <> Неопределено Тогда
		Возврат ИмяИсточника;
	КонецЕсли;
	Возврат "";
	
КонецФункции

